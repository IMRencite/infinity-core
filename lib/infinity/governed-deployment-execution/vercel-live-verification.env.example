# Server-only Vercel live-verification contract. Do not commit real values.
# Do not paste VERCEL_TOKEN into chat.

VERCEL_TOKEN=<server-only-vercel-token>
VERCEL_TOKEN_SCOPE=hosting.create_project,hosting.deploy,hosting.verify_deployment
VERCEL_TOKEN_SCOPE_KIND=INFINITY_INTENDED
VERCEL_TEAM_ID=<test-only-team-id>
INFINITY_VERCEL_TEST_TEAM_CONFIRMED=true
INFINITY_VERCEL_TEST_RESOURCE=infinity-test-live-verification-gde
INFINITY_VERCEL_TEST_REPO=<owner>/infinity-test-live-verification-gde
INFINITY_VERCEL_TEST_SHA=<immutable-40-char-git-sha>
INFINITY_VERCEL_TEST_ARTIFACT_ID=infinity-vercel-live-verification-artifact-v1
INFINITY_VERCEL_LEFTOVER_RESOURCE_ACCEPTED=true
LIVE_PROVIDER_TEST_MODE=true
GITHUB_TOKEN=<server-only-github-read-token>
