# Server-only (never use NEXT_PUBLIC_* for secrets)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2

# Governed reasoning modes: mock | shadow | advisory | disabled (default: disabled)
AI_REASONING_MODE=disabled
AI_PROVIDER_ALLOW_LIVE_EXECUTION=false

# Optional cost controls
AI_REASONING_MAX_INPUT_TOKENS=16000
AI_REASONING_MAX_ESTIMATED_COST_USD=1
AI_REASONING_MAX_SESSIONS_PER_STAGE=1

# Live OpenAI tests (off by default)
RUN_LIVE_OPENAI_TESTS=false

# Discovery Engine v1 (live fetches off by default; use manual provider in tests)
DISCOVERY_ALLOW_LIVE_FETCH=false
# DISCOVERY_RSS_FEED_URLS=https://example.com/feed.xml
# DISCOVERY_GOOGLE_TRENDS_TOPICS=ai agents,saas tools
# PRODUCT_HUNT_API_TOKEN=
# GITHUB_TOKEN=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
